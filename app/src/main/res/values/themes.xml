<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Activity window theme. The real UI is pure Jetpack Compose (tv-material3); this framework
      theme only governs the launch window before Compose draws, so we keep it minimal and paint the
      window the brand background to avoid a flash. App default theme is AMOLED dark.
    -->
    <style name="Theme.OwnTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:statusBarColor">@color/owntv_window_bg</item>
        <item name="android:navigationBarColor">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      The cold start shows the original ZenPlay logo on the same navy background as the UI.
      Existing launcher-activity themes are retained so restored icon preferences remain valid.
      Every activity uses the same ZenPlay artwork, including Android 12 and later.
    -->
    <style name="Theme.OwnTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnTV</item>
    </style>
    <style name="Theme.OwnTV.Starting.Petrol">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Sunflower">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Cobalt">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Tomato">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Board">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Eggshell">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.Olive">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTV.Starting.OliveCream">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
</resources>
