<resources>
    <!--
      Activity window theme. The real UI is pure Jetpack Compose (Material 3); this theme only
      governs the launch window before Compose draws, so it is kept minimal and paints the window the
      brand background to avoid a flash.

      **The parent is AppCompat, and it has to be.** The Cast device chooser is an AppCompat dialog,
      and it is built by a DialogFragment against the ACTIVITY's theme — not against the themed
      wrapper the route button itself is given. Under the old framework Material parent the AppCompat
      `colorPrimary` attribute did not exist at all, so MediaRouter read it as 0, decided its own
      background was transparent, and threw `IllegalArgumentException: background can not be
      translucent: #0` the instant the button was tapped.

      DayNight rather than a fixed light or dark: this theme dresses system-drawn surfaces, and those
      follow the phone. ZenPlay's own light/dark setting is a Compose matter and is unaffected.
    -->
    <style name="Theme.OwnTVMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Every compatible launcher component displays the original ZenPlay logo. postSplashScreenTheme
      hands back to the AppCompat theme the Cast chooser needs after MainActivity installs the splash.
    -->
    <style name="Theme.OwnTVMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnTVMobile</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Petrol">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Sunflower">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Cobalt">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Tomato">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Board">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Eggshell">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Olive">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.OliveCream">
        <item name="windowSplashScreenAnimatedIcon">@drawable/zenplay_splash</item>
    </style>

    <!--
      The route button's own dressing, and nothing else: which way round the icon is tinted. It is
      applied through a ContextThemeWrapper in CastRouteButton.kt, because that choice follows ZenPlay's
      theme setting rather than the phone's night mode.
    -->
    <style name="Theme.OwnTVMobile.CastButton" parent="Theme.AppCompat.NoActionBar">
        <item name="mediaRouteButtonStyle">@style/Widget.OwnTVMobile.MediaRouteButton.Light</item>
    </style>

    <!--
      The same button on a light surface. Which of the two is used is decided from the app's OWN
      theme rather than from the system's night mode, because ZenPlay's theme is a setting: a user on
      Light with the phone in dark mode would otherwise get a white icon on a white bar.
    -->
    <style name="Theme.OwnTVMobile.CastButton.Dark">
        <item name="mediaRouteButtonStyle">@style/Widget.OwnTVMobile.MediaRouteButton.Dark</item>
    </style>

    <style name="Widget.OwnTVMobile.MediaRouteButton.Light" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">@android:color/white</item>
    </style>

    <style name="Widget.OwnTVMobile.MediaRouteButton.Dark" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">#DE000000</item>
    </style>
</resources>
